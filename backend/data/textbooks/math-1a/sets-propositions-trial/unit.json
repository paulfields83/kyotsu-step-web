            "連続する"
          ]
        },
        {
          "id": "m1-bp-007",
          "label": "7",
          "prompt": "互いに素という条件との関係",
          "answerType": "text",
          "choices": [
            "矛盾",
            "一致",
            "同値",
            "無関係"
          ]
        },
        {
          "id": "m1-bp-008",
          "label": "8",
          "prompt": "最後の結論",
          "answerType": "text",
          "choices": [
            "無理数",
            "有理数",
            "整数",
            "自然数"
          ]
        }
      ]
    }
  ]
