          ]
        },
        {
          "id": "s1-math-a-sets-t06-p030",
          "type": "paragraph",
          "parts": [
            {
              "type": "text",
              "text": "1　0個選ぶ ∅、1個選ぶ3通り、2個選ぶ3通り、3個選ぶA自身。全部で "
